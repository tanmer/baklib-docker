# ============================================
# Baklib Docker Compose 环境变量（由 templates/.env.erb 渲染生成）
# ============================================
# 生成方式：
# 1. 推荐：docker compose -f docker-compose.cli.yml run --rm config（或本机 rake config）写入根目录 .env
# 2. 默认值与键列表：templates/env_defaults.env（首次无 .env 时亦据此生成）
# 3. 部署：install → docker compose up -d（详见 README 与 docker-compose.cli.yml 注释）

# ============================================
# 基础配置
# ============================================

# Docker 镜像配置
<%= ls('IMAGE_NAME') %>
<%= ls('IMAGE_TAG') %>

# CLI 镜像（config/install/import-themes/clean 使用，已由项目预构建发布，无需本地构建）
# 未设置时默认使用 registry.devops.tanmer.com/library/baklib-cli:latest
<%= ls('BAKLIB_CLI_IMAGE') %>

# 网络名称
<%= ls('KAMAL_NETWORK_NAME') %>

# ============================================
# Traefik 配置
# ============================================

# Traefik 镜像（可选，默认使用 registry.devops.tanmer.com/library/traefik:v3.1.0）
<%= ls('TRAEFIK_IMAGE') %>

# HTTPS 入口 TLS 版本（写入 traefik/etc/dynamic/sni-strict.yml；至少一项为 y）
<%= ls('TRAEFIK_TLS_ENABLE_12') %>
<%= ls('TRAEFIK_TLS_ENABLE_13') %>

# 阿里云 DNS 配置（用于 ACME DNS 挑战，可选）
<%= ls('DNS_ALIYUN_ACCESS_KEY') %>
<%= ls('DNS_ALIYUN_SECRET_KEY') %>

<% if https_enabled? -%>
# ============================================
# HTTPS / ACME 证书（由配置向导在开启 HTTPS 时写入）
# ============================================
<%= ls('MAIN_DOMAIN_CERT_RESOLVER') %>
<%= ls('SAAS_DOMAIN_CERT_RESOLVER') %>
<%= ls('API_DOMAIN_CERT_RESOLVER') %>
<%= ls('FREE_DOMAIN_CERT_RESOLVER') %>
<%= ls('ACME_EMAIL') %>

<% end -%>
# ============================================
# 数据库配置
# ============================================

<%= ls('POSTGRES_IMAGE') %>
<%= ls('POSTGRES_PASSWORD') %>

# ============================================
# Redis 配置
# ============================================

<%= ls('REDIS_IMAGE') %>

# ============================================
# 应用核心配置（必填）
# ============================================

# Rails Secret Key Base（必须设置，使用 rails secret 生成）
<%= ls('SECRET_KEY_BASE') %>

# 域名配置
<%= ls('MAIN_DOMAIN') %>
<%= ls('SAAS_DOMAIN_SUFFIX') %>
<%= ls('FREE_DOMAIN_SUFFIX') %>
<%= ls('CNAME_DNS_SUFFIX') %>

# 本地试用，不需要发送登陆验证码
<%= ls('SHOW_VERIFICATION_CODE') %>
<%= ls('INGRESS_PROTOCOL') %>
<%= ls('INGRESS_PORT') %>

# 服务器配置
<%= ls('EXTERNAL_IP') %>
<%= ls('ALLOW_CREATE_ORGANIZATION') %>
<%= ls('RESERVED_ORGANIZATION_IDENTIFIERS') %>

# 管理员账号（首个用户登录手机号，install 时会预启动并写入数据库）
<%= ls('ADMIN_PHONE') %>

# ============================================
# ETCD 配置
# ============================================

# ETCD 镜像（可选，默认使用 registry.devops.tanmer.com/library/etcd:v3.5.26）
<%= ls('ETCD_IMAGE') %>

# ETCD Root 密码（必填，用于 etcd 集群认证）
<%= ls('ETCD_ROOT_PASSWORD') %>

# 注意：
# - ETCD_ENDPOINTS 和 ETCD_USER 在 docker-compose.yml 中已设置为固定值（基于 Docker Compose 服务名称）
# - 如果使用外部 etcd 服务，可以在 docker-compose.yml 的 environment 中覆盖这些值

# ============================================
# 可选配置
# ============================================

<%= ls('SAAS_DOMAIN_TLD_LENGTH') %>
<%= ls('ASSET_CDN_HOST') %>
<%= ls('RAILS_MAX_THREADS') %>
<%= ls('WEB_CONCURRENCY') %>
<%= ls('WEB_MEMORY') %>
<%= ls('APP_DATABASE_POOL') %>
<%= ls('REDIS_POOL') %>
<%= ls('API_MAX_PAGE_SIZE') %>
<%= ls('PAGE_PREVIEW_SKIP_IP_VALIDATION') %>

# ============================================
# 短信服务配置
# ============================================

# 短信适配器: ucloud, aliyun, qiyewechat
<%= ls('TEXT_MESSAGE_ADAPTER') %>
<%= ls('TEXT_MESSAGE_LOGIN_TEMPLATE') %>

# UCloud 短信配置
<%= ls('TEXT_MESSAGE_UCLOUD_PUBLIC_KEY') %>
<%= ls('TEXT_MESSAGE_UCLOUD_PRIVATE_KEY') %>
<%= ls('TEXT_MESSAGE_UCLOUD_PROJECT_ID') %>
<%= ls('TEXT_MESSAGE_UCLOUD_SIG_CONTENT') %>
<%= ls('TEXT_MESSAGE_UCLOUD_BAKLIB_LOGIN_TEMPLATE_ID') %>
<%= ls('TEXT_MESSAGE_UCLOUD_BAKLIB_LOGIN_TEMPLATE') %>

# 阿里云短信配置
<%= ls('TEXT_MESSAGE_ALIYUN_ACCESS_KEY_ID') %>
<%= ls('TEXT_MESSAGE_ALIYUN_ACCESS_KEY_SECRET') %>
<%= ls('TEXT_MESSAGE_ALIYUN_SIG_CONTENT') %>
<%= ls('TEXT_MESSAGE_ALIYUN_BAKLIB_LOGIN_TEMPLATE_ID') %>
<%= ls('TEXT_MESSAGE_ALIYUN_BAKLIB_LOGIN_TEMPLATE') %>

# 企业微信短信配置
<%= ls('TEXT_MESSAGE_QIYEWECHAT_KEY') %>

# ============================================
# 存储服务配置
# ============================================

# 存储服务: qinium, aliyun, amazon, local
# 如果设置为 local，需要确保项目根目录下的 storage 目录挂载到容器中
<%= ls('STORAGE_SAAS_DEFAULT_SERVICE') %>
# <%= storage_hint %>
<% if saas_storage_qinium? -%>

# 七牛云存储配置
<%= ls('STORAGE_QINIU_ACCESS_KEY') %>
<%= ls('STORAGE_QINIU_SECRET_KEY') %>
<%= ls('STORAGE_QINIU_BUCKET') %>
<%= ls('STORAGE_QINIU_PROTOCOL') %>
<%= ls('STORAGE_QINIU_DOMAIN') %>
<% end -%>
<% if saas_storage_aliyun_oss? -%>

# 阿里云存储配置
<%= ls('STORAGE_ALIYUN_ACCESS_KEY') %>
<%= ls('STORAGE_ALIYUN_SECRET_KEY') %>
<%= ls('STORAGE_ALIYUN_BUCKET') %>
<%= ls('STORAGE_ALIYUN_ENDPOINT') %>
<%= ls('STORAGE_ALIYUN_CDN_HOST') %>
<%= ls('STORAGE_ALIYUN_CDN_KEY') %>
<%= ls('STORAGE_ALIYUN_PUBLIC') %>
<% end -%>
<% if saas_storage_amazon_s3? -%>

# AWS 存储配置
<%= ls('STORAGE_AWS_ACCESS_KEY') %>
<%= ls('STORAGE_AWS_SECRET_KEY') %>
<%= ls('STORAGE_AWS_BUCKET') %>
<%= ls('STORAGE_AWS_REGION') %>
<%= ls('STORAGE_AWS_PUBLIC') %>
<%= ls('STORAGE_AWS_EXPIRES_IN') %>
<%= ls('STORAGE_AWS_CDN_HOST') %>
<%= ls('STORAGE_AWS_CDN_PUBLIC_KEY_ID') %>
<%= ls('STORAGE_AWS_CDN_PRIVATE_KEY_BASE64') %>
<% end -%>

# ============================================
# 邮件服务配置
# ============================================

# 邮件发送方式: smtp, sendmail, none
<%= ls('MAILER_DELIVERY_METHOD') %>
<%= ls('MAILER_SEND_FROM') %>
<%= ls('MAILER_SMTP_HOST') %>
<%= ls('MAILER_SMTP_PORT') %>
<%= ls('MAILER_SMTP_USERNAME') %>
<%= ls('MAILER_SMTP_PASSWORD') %>
<%= ls('MAILER_SMTP_DOMAIN') %>
<%= ls('MAILER_SMTP_AUTHENTICATION') %>
<%= ls('MAILER_SMTP_ENABLE_STARTTLS_AUTO') %>
<%= ls('MAILER_SMTP_SSL') %>
<% if sentry_vars_present? -%>

# ============================================
# 监控和日志
# ============================================

# Sentry 配置（可选）
<%= ls('SENTRY_DSN') %>
<%= ls('SENTRY_CURRENT_ENV') %>
<% end -%>
<% if github_proxy_present? -%>

# ============================================
# 其他配置
# ============================================

<%= ls('GITHUB_PROXY_URL') %>
<% end -%>

