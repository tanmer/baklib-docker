global:
  checkNewVersion: false
entryPoints:
  http:
    address: ":80"
  https:
    address: ":443"
    transport:
      respondingTimeouts:
        readTimeout: <%= traefik_read_timeout %> # v2.11.2+/v3 默认 60s；本地存储 1200s、云存储 300s，兼顾大文件与 Harbor push 等场景
  admin:
    address: ":8081"
providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true
    debugLogGeneratedTemplate: true
  docker:
    exposedByDefault: false
  etcd:
    endpoints:
      - "etcd01:2379"
      - "etcd02:2379"
      - "etcd03:2379"
<% if etcd_password_present? -%>
    username: root
    # 注意：这里的密码需要与 .env 文件中的 ETCD_ROOT_PASSWORD 保持一致
    password: <%= ENV['ETCD_ROOT_PASSWORD'] %>
<% else -%>
    #username: root
    # 注意：这里的密码需要与 .env 文件中的 ETCD_ROOT_PASSWORD 保持一致
    #password: your_etcd_root_password_here
<% end -%>
api:
  insecure: true
  dashboard: true
  debug: false
  disableDashboardAd: true
log:
  level: INFO
  filePath: /var/log/traefik.log
  maxAge: 60
  compress: true
accessLog:
  addInternals: false
  filePath: /var/log/access.log
#   format: json
#   fields:
#     defaultMode: keep
#     names:
#       ClientUsername: drop
#     headers:
#       defaultMode: keep
#       names:
#         User-Agent: redact
#         Authorization: drop
#         Content-Type: keep

<% if https_enabled? -%>
certificatesResolvers:
  http01:
    acme:
      email: '<%= acme_email %>'
      storage: "/etc/traefik/letsencrypt/http01.json"
      httpChallenge:
        entryPoint: http
  alidns:
    acme:
      email: '<%= acme_email %>'
      storage: "/etc/traefik/letsencrypt/alidns.json"
      dnsChallenge:
        provider: alidns
<% else -%>
#certificatesResolvers:
